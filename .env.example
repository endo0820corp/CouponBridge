# 楽天RMS WEB SERVICE 認証情報
# 店舗ごとに serviceSecret / licenseKey を設定します。
# 既存互換: ゆかい屋は RMS_SERVICE_SECRET / RMS_LICENSE_KEY でも動きます。

RMS_YUKAIYA_SERVICE_SECRET=
RMS_YUKAIYA_LICENSE_KEY=

RMS_KAIRY_SERVICE_SECRET=
RMS_KAIRY_LICENSE_KEY=

# 旧版互換用。新規では上の店舗別キー推奨。
RMS_SERVICE_SECRET=
RMS_LICENSE_KEY=

# CouponAPI エンドポイント
RMS_COUPON_ISSUE_URL=https://api.rms.rakuten.co.jp/es/1.0/coupon/issue
RMS_COUPON_SEARCH_URL=https://api.rms.rakuten.co.jp/es/1.0/coupon/search
RMS_COUPON_GET_URL=https://api.rms.rakuten.co.jp/es/1.0/coupon/get

# true: coupon.issue は送信せずXML確認のみ
# false: coupon.issue を実行します。coupon.search は次回期間取得・重複チェックのためDRY_RUNでも実行します。
DRY_RUN=true

PORT=5174
